# Supabase Project Settings > API. Public key only; never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set only after enabling the Telegram OIDC provider in Supabase.
# Its identifier must match exactly, e.g. custom:telegram.
NEXT_PUBLIC_TELEGRAM_AUTH_PROVIDER=

# Optional. A server key is shared by signed-in users; omit for a public launch
# where each user brings their own Google AI Studio key in the app.
GEMINI_API_KEY=

# Server only. TMDB v4 read token or v3 key: films and series lists, upcoming titles.
TMDB_API_KEY=

# Notifications. Server only (the public VAPID key reaches browsers through /api/notifications/prefs).
# Supabase secret key (sb_secret_...): lets the notification job read members' schedules.
SUPABASE_SECRET_KEY=
# Resend API key with sending access to afterwatch.online.
RESEND_API_KEY=
# Web push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared with the Supabase schedule that calls /api/cron/notify (32+ random characters).
CRON_SECRET=
